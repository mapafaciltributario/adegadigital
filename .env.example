# Nunca coloque segredos em variáveis VITE_ (elas vão para o navegador).
# Secrets: Project Settings → Secrets. Config pública (VITE_*): também em Secrets/variáveis de build.

# ── Cakto (Secret) — Painel Cakto → Integrações → Cakto API. Escopos: read write offers orders payments
CAKTO_CLIENT_ID=
CAKTO_CLIENT_SECRET=
# ── Ofertas (Config, servidor). O preço na Cakto precisa bater com o da página.
CAKTO_OFFER_ID_COMPLETO=   # R$ 24,90
CAKTO_OFFER_ID_ESPECIAL=   # R$ 17,90
CAKTO_OFFER_ID_BASICO=     # R$ 10,00
# ── Order bumps (Config, servidor). Cada um deve ser oferta ativa na Cakto exatamente neste preço.
CAKTO_BUMP_ZERO=          # R$ 6,90
CAKTO_BUMP_ETIQUETAS=     # R$ 5,90
CAKTO_BUMP_CANVA=         # R$ 6,90
CAKTO_BUMP_PRECIFICADORA= # R$ 5,90
CAKTO_BUMP_COMBO=         # R$ 16,64
# ── Webhook (Secret) — gerado pela Cakto ao criar o webhook para {site}/api/public/cakto-webhook
CAKTO_WEBHOOK_SECRET=

# ── Área de membros (Config, servidor) — link oficial da área de membros da Cakto para este produto (https://...)
APP_ACCESS_URL=

# ── Meta (Pixel + API de Conversões)
VITE_META_PIXEL_ID=        # Config pública: Gerenciador de Eventos → Fonte de dados → ID
META_PIXEL_ID=             # Config, servidor: mesmo ID acima
META_CAPI_ACCESS_TOKEN=    # Secret: Gerenciador de Eventos → Configurações → API de Conversões → Gerar token
META_TEST_EVENT_CODE=      # Config, opcional: só durante testes (Eventos de teste). Deixe vazio em produção.

# ── LowTrack (Config pública) — URL do script copiada do painel LowTrack (https://...)
VITE_LOWTRACK_PIXEL_URL=

# ── Hospedagem (Config de build) — na Vercel: Settings → Environment Variables
NITRO_PRESET=vercel

# LowTrack server API token
LOWTRACK_API_TOKEN=
